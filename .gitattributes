# Automatically detect text files
* text=auto

# .NET
*.cs text
*.csproj text
*.sln text
*.props text
*.targets text

# SQL Server
*.sql text
*.sqlproj text

# Frontend
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Documentation and configuration
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gitignore text eol=lf
*.editorconfig text eol=lf
